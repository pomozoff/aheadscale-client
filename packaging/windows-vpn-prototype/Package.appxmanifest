<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
 xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
 xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
 xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
 xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
 IgnorableNamespaces="uap uap5 desktop rescap">
 <Identity Name="Aheadscale.VpnPrototype" Publisher="CN=Aheadscale VPN Prototype" Version="@VERSION@" ProcessorArchitecture="arm64"/>
 <Properties><DisplayName>Aheadscale VPN Prototype</DisplayName><PublisherDisplayName>Aheadscale</PublisherDisplayName><Logo>Assets\StoreLogo.png</Logo></Properties>
 <Dependencies><TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.26100.0" MaxVersionTested="10.0.26100.0"/></Dependencies>
 <Resources><Resource Language="en-us"/><Resource Language="ru-ru"/></Resources>
 <Applications>
  <Application Id="Controller" Executable="AheadscaleVpnController.exe" EntryPoint="Windows.FullTrustApplication">
   <uap:VisualElements DisplayName="Aheadscale VPN Prototype" Description="Опытный контроллер Windows VPN Aheadscale" BackgroundColor="#2563EB" Square150x150Logo="Assets\Logo.png" Square44x44Logo="Assets\SmallLogo.png"/>
   <Extensions>
    <uap5:Extension Category="windows.appExecutionAlias" Executable="AheadscaleVpnController.exe" EntryPoint="Windows.FullTrustApplication">
     <uap5:AppExecutionAlias><uap5:ExecutionAlias Alias="aheadscale-vpn-prototype.exe"/></uap5:AppExecutionAlias>
    </uap5:Extension>
   </Extensions>
  </Application>
  <Application Id="Plugin">
   <uap:VisualElements DisplayName="Aheadscale VPN Prototype" Description="Опытный VPN-плагин Aheadscale" BackgroundColor="#2563EB" Square150x150Logo="Assets\Logo.png" Square44x44Logo="Assets\SmallLogo.png" AppListEntry="none"/>
   <Extensions>
    <desktop:Extension Category="windows.fullTrustProcess" Executable="AheadscaleVpnBroker.exe"/>
    <uap:Extension Category="windows.appService" Executable="AheadscaleVpnHost.exe" EntryPoint="Aheadscale.VpnPrototype.BackgroundTask">
     <uap:AppService Name="Aheadscale.VpnPrototype.Broker"/>
    </uap:Extension>
    <Extension Category="windows.backgroundTasks" Executable="AheadscaleVpnHost.exe" EntryPoint="Aheadscale.VpnPrototype.BackgroundTask">
     <BackgroundTasks><uap:Task Type="vpnClient"/></BackgroundTasks>
    </Extension>
   </Extensions>
  </Application>
 </Applications>
 <Extensions>
  <Extension Category="windows.activatableClass.inProcessServer">
   <InProcessServer><Path>AheadscaleVpnPlugin.dll</Path><ActivatableClass ActivatableClassId="Aheadscale.VpnPrototype.BackgroundTask" ThreadingModel="both"/></InProcessServer>
  </Extension>
 </Extensions>
 <Capabilities><Capability Name="internetClientServer"/><Capability Name="privateNetworkClientServer"/><rescap:Capability Name="networkingVpnProvider"/><rescap:Capability Name="runFullTrust"/></Capabilities>
</Package>
