FROM ubuntu@sha256:24737cef17f4e22b1977df7d9a05e77c4e28b7da5b8911f8d8ccda136bf3573c
RUN apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends gcc g++ pkg-config libgtk-4-dev libwebkitgtk-6.0-dev libsoup-3.0-dev libnm-dev libnma-dev libnma-gtk4-dev libgtk-3-dev meson ninja-build ca-certificates && rm -rf /var/lib/apt/lists/*
RUN apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
