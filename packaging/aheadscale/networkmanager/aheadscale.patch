diff --git a/internal/nmplugin/config_abi_test.go b/internal/nmplugin/config_abi_test.go
new file mode 100644
index 0000000..5280c9a
--- /dev/null
+++ b/internal/nmplugin/config_abi_test.go
@@ -0,0 +1,24 @@
+package nmplugin
+
+import (
+	"encoding/binary"
+	"net/netip"
+	"testing"
+)
+
+func TestIPv4GatewayMatchesNetworkManagerInAddrABI(t *testing.T) {
+	// NM consumes the uint32 as struct in_addr.s_addr (network-order bytes
+	// in native integer storage), rather than as a numerical big-endian word.
+	for _, address := range []string{"95.84.192.230", "203.0.113.9", "::ffff:192.0.2.7"} {
+		ip := netip.MustParseAddr(address).Unmap()
+		value, ok := gatewayVariantForAddr(ip)
+		if !ok {
+			t.Fatal("valid gateway was rejected")
+		}
+		var memory [4]byte
+		binary.NativeEndian.PutUint32(memory[:], value.Value().(uint32))
+		if actual := netip.AddrFrom4(memory); actual != ip {
+			t.Fatalf("NetworkManager sees %s instead of %s", actual, ip)
+		}
+	}
+}
