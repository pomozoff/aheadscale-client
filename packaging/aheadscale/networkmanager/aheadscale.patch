@@ -0,0 +1,69 @@
+package compat
+
+import (
+	"context"
+	"os"
+	"testing"
+	"time"
+
+	"github.com/netbirdio/network-manager-plugin/internal/netbird/daemonclient"
+	"github.com/netbirdio/network-manager-plugin/internal/netbird/profile"
+)
+
+// The fixture is compiled independently against the Aheadscale daemon's proto,
+// so this exercises wire compatibility rather than the upstream generated types.
+func TestAheadscaleDefaultDaemon(t *testing.T) {
+	if daemonclient.DefaultAddress != "unix:///var/run/aheadscale.sock" {
+		t.Fatalf("wrong default daemon address: %s", daemonclient.DefaultAddress)
+	}
+	if daemonclient.DefaultDaemonService != "aheadscale" {
+		t.Fatalf("wrong default service: %s", daemonclient.DefaultDaemonService)
+	}
+	address := os.Getenv("AHEADSCALE_COMPAT_DAEMON")
+	if address == "" {
+		t.Fatal("AHEADSCALE_COMPAT_DAEMON must name the independent Aheadscale protocol fixture")
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	c, err := daemonclient.NewFactory(daemonclient.Options{Address: address}).NewClient(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c.Close()
+	features, err := c.GetFeatures(ctx)
+	if err != nil || !features.DisableProfiles {
+		t.Fatalf("single default not supported: %+v %v", features, err)
+	}
+	desired, err := profile.PrepareActivation(ctx, c, daemonclient.ProfileRef{ProfileName: "must-not-create", Username: "test"})
+	if err != nil || !desired.Empty() {
+		t.Fatalf("unexpected new profile: %+v %v", desired, err)
+	}
+	if _, err := profile.EnsureExists(ctx, c, desired); err != nil {
+		t.Fatal(err)
+	}
+	resolved, err := profile.Resolve(ctx, c, desired)
+	if err != nil || !resolved.Empty() {
+		t.Fatalf("unexpected resolved profile: %+v %v", resolved, err)
+	}
+	if _, err := c.GetConfig(ctx, resolved); err != nil {
+		t.Fatal(err)
+	}
+	login, err := c.Login(ctx, daemonclient.LoginRequest{Profile: resolved, ManagementURL: "https://aheadscale.ru", AdminURL: "https://aheadscale.ru"})
+	if err != nil || !login.NeedsSSOLogin || login.UserCode != "TEST-CODE" {
+		t.Fatalf("login contract: %+v %v", login, err)
+	}
+	sso, err := c.WaitSSOLogin(ctx, daemonclient.WaitSSOLoginRequest{UserCode: login.UserCode})
+	if err != nil || sso.Email != "test@example.invalid" {
+		t.Fatalf("SSO contract: %+v %v", sso, err)
+	}
+	if err := c.Up(ctx, resolved); err != nil {
+		t.Fatal(err)
+	}
+	st, err := c.Status(ctx, daemonclient.StatusOptions{})
+	if err != nil || st.GetStatus() != "Connected" {
+		t.Fatalf("status contract: %+v %v", st, err)
+	}
+	if err := c.Down(ctx); err != nil {
+		t.Fatal(err)
+	}
+}
