@@ -0,0 +1,40 @@
+package aheadscale
+
+import (
+	"context"
+	"net"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func TestBrokerRejectsUnprivilegedServer(t *testing.T) {
+	if os.Geteuid() == 0 {
+		t.Skip("requires an unprivileged peer")
+	}
+	path := filepath.Join(t.TempDir(), "broker")
+	listener, err := net.Listen("unix", path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		c, err := listener.Accept()
+		if err == nil {
+			defer c.Close()
+			_ = c.SetDeadline(time.Now().Add(time.Second))
+			b := make([]byte, 1)
+			if n, _ := c.Read(b); n != 0 {
+				t.Error("sent message before verifying root server")
+			}
+		}
+	}()
+	_, err = NewBroker(path).Begin(context.Background())
+	if err == nil {
+		t.Fatal("accepted non-root controller")
+	}
+	<-done
+}
