diff --git a/plasma/README.md b/plasma/README.md
new file mode 100644
index 0000000..c6a43e5
--- /dev/null
+++ b/plasma/README.md
@@ -0,0 +1,51 @@
+# Интеграция Aheadscale с Plasma 6
+
+Plasma проверяет наличие собственного `VpnUiPlugin` **до** обращения к
+NetworkManager. GTK-редактор и GNOME auth-dialog эту проверку не заменяют.
+Модуль регистрирует только `org.freedesktop.NetworkManager.aheadscale`;
+соединение и отмена остаются штатными операциями NetworkManager.
+
+Редактор показывает управляемое подключение, сохраняя его настройки без
+перезаписи. При запросе SSO открывает браузер и возвращает маркер продолжения
+с ID текущей активации. Данные входа, URL и коды не сохраняются в настройках
+профиля. Отмена диалога обрабатывается штатным агентом Plasma; уничтоженный
+диалог не открывает отложенную вкладку.
+
+## Сборка и проверка
+
+Используется установленная библиотека `plasmanm_editor`, а не её собственная
+копия. Заголовки SDK берутся из неизменённого upstream plasma-nm v6.6.6,
+коммит `1a7177547b3e23bb6f41447c99ba83d087ba0e26`:
+
+- `libs/editor/vpnuiplugin.h`;
+- `libs/editor/widgets/settingwidget.h`.
+
+Сборка проверяет оба SHA256. Заголовки имеют исходные уведомления KDE и
+лицензию LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL;
+они не включаются в пакет Aheadscale. Исходники самого адаптера — BSD-3-Clause.
+
+На Ubuntu для сборки нужны `cmake`, `g++`, `qt6-base-dev`,
+`libkf6coreaddons-dev`, `libkf6networkmanagerqt-dev`, `libkf6widgetsaddons-dev`,
+`libnm-dev` и установленный `plasma-nm`. Для GNOME устанавливать KDE не нужно:
+модуль загружается только Plasma.
+
+```sh
+cmake -S plasma -B build/plasma -DPLASMA_NM_SOURCE=/путь/к/проверенному/sdk
+cmake --build build/plasma -j2
+ctest --test-dir build/plasma --output-on-failure
+```
+
+Тест использует настоящий поиск и загрузчик KDE, проверяет сохранение настроек,
+браузерный SSO, ID активации, запрет небезопасного URL и уничтожение диалога.
+Заголовки SDK могут находиться в минимальном дереве с указанными двумя файлами.
+
+Артефакт: `build/plasma/plugins/plasma/network/vpn/plasmanetworkmanagement_aheadscaleui.so`.
+В DEB путь установки зависит от архитектуры, в RPM — `/usr/lib64/qt6/plugins/`.
+Пакет обязан включить модуль в квитанцию собственных файлов и удалять его
+штатным жизненным циклом. Ручное копирование модуля в систему не является
+приёмкой установщика.
+
+Первичная проверка сборки: Ubuntu 26.04 ARM64, Plasma 6.6.6, Qt 6.10.2,
+KF 6.24. Совместимость других версий Qt/Plasma, KDE 5 и RPM отдельно не доказана.
+Пока не проверены ABI и зависимости, такой артефакт нельзя включать в общий
+публичный выпуск для всех дистрибутивов.
diff --git a/plasma/aheadscale.cpp b/plasma/aheadscale.cpp
new file mode 100644
index 0000000..5c37bbb
--- /dev/null
+++ b/plasma/aheadscale.cpp
@@ -0,0 +1,121 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#include "vpnuiplugin.h"
+#include <QDesktopServices>
+#include <QLabel>
+#include <QPushButton>
+#include <QTimer>
+#include <QUrl>
+#include <QVBoxLayout>
+
+namespace {
+constexpr auto activationKey = "x-aheadscale-activation-id";
+constexpr auto continueKey = "x-aheadscale-sso-continue";
+
+// The default port is normalized so an explicit :443 matches the same origin.
+bool sameOrigin(const QUrl &left, const QUrl &right)
+{
+    return left.scheme() == right.scheme() && left.host() == right.host()
+        && left.port(443) == right.port(443);
+}
+
+class AheadscaleWidget final : public SettingWidget {
+public:
+    AheadscaleWidget(const NetworkManager::VpnSetting::Ptr &setting, QWidget *parent)
+        : SettingWidget(setting, parent), saved(setting->toMap())
+    {
+        auto *layout = new QVBoxLayout(this);
+        auto *label = new QLabel(tr("Подключение настроено приложением Aheadscale. "
+                                   "Вход и управление устройствами доступны в Aheadscale."), this);
+        label->setWordWrap(true);
+        layout->addWidget(label);
+    }
+
+    AheadscaleWidget(const NetworkManager::VpnSetting::Ptr &setting,
+                     const QStringList &hints, QWidget *parent)
+        : SettingWidget(setting, hints, parent), login(true), valid(false)
+    {
+        auto *layout = new QVBoxLayout(this);
+        message = new QLabel(this);
+        message->setTextFormat(Qt::PlainText);
+        message->setWordWrap(true);
+        layout->addWidget(message);
+        QMap<QString, QString> values;
+        bool duplicate = false;
+        for (const auto &hint : hints) {
+            const auto split = hint.indexOf('=');
+            const auto key = split < 0 ? hint : hint.left(split);
+            if (values.contains(key)) duplicate = true;
+            values.insert(key, split < 0 ? QStringLiteral("true") : hint.mid(split + 1));
+        }
+        bool numeric = false;
+        const auto generation = values.value(QLatin1String(activationKey)).toULongLong(&numeric);
+        const auto complete = values.value(QStringLiteral("x-aheadscale-sso-verification-uri-complete"));
+        url = QUrl(complete.isEmpty() ? values.value(QStringLiteral("x-aheadscale-sso-verification-uri")) : complete);
+        const auto data = setting->data();
+        const QUrl management(data.value(QStringLiteral("management-url")));
+        const QUrl admin(data.value(QStringLiteral("admin-url")));
+        // The internal test channel still uses the public Aheadscale identity
+        // provider. These are the existing pinned Aheadscale endpoints.
+        const bool internalToPublic = management.host() == QStringLiteral("macmini.tailb71cbe.ts.net")
+            && sameOrigin(url, QUrl(QStringLiteral("https://aheadscale.ru")));
+        valid = !duplicate && numeric && generation > 0
+            && values.value(QStringLiteral("x-aheadscale-sso")) == QStringLiteral("true")
+            && url.isValid() && url.scheme() == QStringLiteral("https")
+            && !url.host().isEmpty() && url.userInfo().isEmpty()
+            && (sameOrigin(url, management) || sameOrigin(url, admin) || internalToPublic);
+        if (!valid) {
+            message->setText(tr("Не удалось открыть безопасную страницу входа Aheadscale. "
+                                "Отмените подключение и повторите вход в приложении."));
+            return;
+        }
+        activation = values.value(QLatin1String(activationKey));
+        message->setText(tr("Завершите вход Aheadscale в браузере. "
+                            "После входа подтвердите подключение; для отмены нажмите «Отмена»."));
+        auto *open = new QPushButton(tr("Открыть страницу входа"), this);
+        layout->addWidget(open);
+        connect(open, &QPushButton::clicked, this, [this] { openBrowser(); });
+        // Bound to the dialog lifetime: Cancel/destruction cannot open a stale tab.
+        QTimer::singleShot(0, this, [this] { openBrowser(); });
+    }
+
+    QVariantMap setting() const override
+    {
+        if (!login) return saved;
+        NMStringMap secrets;
+        if (valid) {
+            secrets.insert(QLatin1String(activationKey), activation);
+            secrets.insert(QLatin1String(continueKey), QStringLiteral("true"));
+        }
+        return {{QStringLiteral("secrets"), QVariant::fromValue(secrets)}};
+    }
+    bool isValid() const override { return valid; }
+
+private:
+    void openBrowser()
+    {
+        if (!QDesktopServices::openUrl(url)) {
+            message->setText(tr("Браузер не открылся. Повторите открытие страницы или отмените подключение."));
+        }
+    }
+    QVariantMap saved;
+    bool login = false;
+    bool valid = true;
+    QString activation;
+    QUrl url;
+    QLabel *message = nullptr;
+};
+}
+
+class AheadscaleUiPlugin final : public VpnUiPlugin {
+    Q_OBJECT
+public:
+    explicit AheadscaleUiPlugin(QObject *parent = nullptr, const QVariantList & = {}) : VpnUiPlugin(parent) {}
+    SettingWidget *widget(const NetworkManager::VpnSetting::Ptr &setting, QWidget *parent) override
+    { return new AheadscaleWidget(setting, parent); }
+    SettingWidget *askUser(const NetworkManager::VpnSetting::Ptr &setting, const QStringList &hints, QWidget *parent) override
+    { return new AheadscaleWidget(setting, hints, parent); }
+    QString suggestedFileName(const NetworkManager::ConnectionSettings::Ptr &) const override { return {}; }
+};
+
+K_PLUGIN_CLASS_WITH_JSON(AheadscaleUiPlugin, "plasmanetworkmanagement_aheadscaleui.json")
+#include "aheadscale.moc"
diff --git a/plasma/aheadscale_test.cpp b/plasma/aheadscale_test.cpp
new file mode 100644
index 0000000..1d68f15
--- /dev/null
+++ b/plasma/aheadscale_test.cpp
@@ -0,0 +1,101 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#include "vpnuiplugin.h"
+#include <QDesktopServices>
+#include <QLabel>
+#include <QTest>
+#include <QUrl>
+#include <memory>
+
+class BrowserCapture : public QObject {
+    Q_OBJECT
+public:
+    QList<QUrl> urls;
+public Q_SLOTS:
+    void capture(const QUrl &url) { urls.append(url); }
+};
+
+class AheadscalePlasmaTest : public QObject {
+    Q_OBJECT
+    static constexpr auto service = "org.freedesktop.NetworkManager.aheadscale";
+    NetworkManager::VpnSetting::Ptr vpn() {
+        auto setting = NetworkManager::VpnSetting::Ptr(new NetworkManager::VpnSetting);
+        setting->setServiceType(QString::fromLatin1(service));
+        setting->setData({{"management-url", "https://aheadscale.ru:443"},
+                          {"auth", "sso"}, {"interface-name", "Aheadscale"}});
+        return setting;
+    }
+    std::unique_ptr<VpnUiPlugin> load() {
+        const auto result = VpnUiPlugin::loadPluginForType(nullptr, QString::fromLatin1(service));
+        return std::unique_ptr<VpnUiPlugin>(result.plugin);
+    }
+private Q_SLOTS:
+    void discoverAndLoadLikePlasma() {
+        const auto matches = KPluginMetaData::findPlugins(QStringLiteral("plasma/network/vpn"),
+            [](const KPluginMetaData &md) {
+                return md.value(QStringLiteral("X-NetworkManager-Services")) == QString::fromLatin1(service);
+            });
+        QCOMPARE(matches.size(), 1);
+        auto plugin = load();
+        QVERIFY2(plugin != nullptr, "Plasma must instantiate the Aheadscale VPN UI plugin");
+    }
+    void editorPreservesManagedSettings() {
+        auto plugin = load(); QVERIFY(plugin);
+        auto setting = vpn();
+        const auto original = setting->toMap();
+        std::unique_ptr<SettingWidget> widget(plugin->widget(setting, nullptr));
+        QVERIFY(widget);
+        QCOMPARE(widget->setting(), original);
+        QVERIFY(widget->isValid());
+    }
+    void browserLoginRetainsActivationAndOpensOnce() {
+        auto plugin = load(); QVERIFY(plugin);
+        BrowserCapture browser;
+        QDesktopServices::setUrlHandler("https", &browser, "capture");
+        const QUrl url("https://aheadscale.ru/oauth2/device?user_code=TEST-ONLY");
+        std::unique_ptr<SettingWidget> widget(plugin->askUser(vpn(), {
+            "x-aheadscale-activation-id=71", "x-aheadscale-sso=true",
+            "x-aheadscale-sso-verification-uri-complete=" + url.toString()}, nullptr));
+        QVERIFY(widget); QVERIFY(widget->isValid());
+        QTRY_COMPARE(browser.urls.size(), 1);
+        QCOMPARE(browser.urls.first(), url);
+        auto secrets = widget->setting().value("secrets").value<NMStringMap>();
+        QCOMPARE(secrets.value("x-aheadscale-activation-id"), "71");
+        QCOMPARE(secrets.value("x-aheadscale-sso-continue"), "true");
+        QVERIFY(!secrets.contains("x-aheadscale-sso-verification-uri-complete"));
+        widget.reset();
+        QTest::qWait(30);
+        QCOMPARE(browser.urls.size(), 1);
+        QDesktopServices::unsetUrlHandler("https");
+    }
+    void invalidOrForeignBrowserUrlIsRefused_data() {
+        QTest::addColumn<QString>("url");
+        QTest::newRow("local-file") << "file:///etc/passwd";
+        QTest::newRow("javascript") << "javascript:alert(1)";
+        QTest::newRow("foreign") << "https://foreign.invalid/login";
+        QTest::newRow("credentials") << "https://user:pass@aheadscale.ru/login";
+        QTest::newRow("plaintext") << "http://aheadscale.ru/login";
+    }
+    void invalidOrForeignBrowserUrlIsRefused() {
+        QFETCH(QString, url);
+        auto plugin = load(); QVERIFY(plugin);
+        std::unique_ptr<SettingWidget> widget(plugin->askUser(vpn(), {
+            "x-aheadscale-activation-id=71", "x-aheadscale-sso=true",
+            "x-aheadscale-sso-verification-uri-complete=" + url}, nullptr));
+        QVERIFY(widget); QVERIFY(!widget->isValid());
+        QVERIFY(widget->setting().value("secrets").value<NMStringMap>().isEmpty());
+    }
+    void destroyedDialogCannotOpenBrowserLater() {
+        auto plugin = load(); QVERIFY(plugin);
+        BrowserCapture browser;
+        QDesktopServices::setUrlHandler("https", &browser, "capture");
+        auto *widget = plugin->askUser(vpn(), {
+            "x-aheadscale-activation-id=72", "x-aheadscale-sso=true",
+            "x-aheadscale-sso-verification-uri-complete=https://aheadscale.ru/oauth2/device"}, nullptr);
+        delete widget;
+        QTest::qWait(30);
+        QCOMPARE(browser.urls.size(), 0);
+        QDesktopServices::unsetUrlHandler("https");
+    }
+};
+QTEST_MAIN(AheadscalePlasmaTest)
