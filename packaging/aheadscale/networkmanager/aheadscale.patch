diff --git a/internal/aheadscale/broker.go b/internal/aheadscale/broker.go
new file mode 100644
index 0000000..f54cd17
--- /dev/null
+++ b/internal/aheadscale/broker.go
@@ -0,0 +1,110 @@
+//go:build linux
+
+package aheadscale
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net"
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+const BrokerPath = "/run/aheadscale/networkmanager-control.sock"
+
+type Broker struct{ path string }
+
+type Lease struct {
+	Generation     uint64
+	NonInteractive bool
+}
+type message struct {
+	Version    int
+	Operation  string
+	Generation uint64
+	Phase      string
+}
+type state struct {
+	NonInteractive *bool
+	Generation     uint64
+	Phase          string
+	Error          string
+}
+type reply struct {
+	State state
+	Error string
+}
+
+func NewBroker(path string) *Broker { return &Broker{path: path} }
+func (b *Broker) Begin(ctx context.Context) (Lease, error) {
+	response, err := b.exchange(ctx, message{Version: 2, Operation: "Begin"})
+	if err != nil {
+		return Lease{}, err
+	}
+	if response.Generation == 0 || response.NonInteractive == nil {
+		return Lease{}, fmt.Errorf("%w: отсутствует политика взаимодействия", ErrUnavailable)
+	}
+	return Lease{Generation: response.Generation, NonInteractive: *response.NonInteractive}, nil
+}
+func (b *Broker) Complete(ctx context.Context, generation uint64, phase string) error {
+	_, err := b.exchange(ctx, message{Version: 2, Operation: "Complete", Generation: generation, Phase: phase})
+	return err
+}
+func (b *Broker) Cancel(ctx context.Context, generation uint64) error {
+	_, err := b.exchange(ctx, message{Version: 2, Operation: "Cancel", Generation: generation})
+	return err
+}
+func (b *Broker) exchange(ctx context.Context, request message) (state, error) {
+	ctx, cancel := context.WithTimeout(ctx, 5*time.Second)
+	defer cancel()
+	connection, err := (&net.Dialer{}).DialContext(ctx, "unix", b.path)
+	if err != nil {
+		return state{}, fmt.Errorf("%w: %w", ErrUnavailable, err)
+	}
+	defer connection.Close()
+	stop := context.AfterFunc(ctx, func() { _ = connection.Close() })
+	defer stop()
+	if deadline, ok := ctx.Deadline(); ok {
+		_ = connection.SetDeadline(deadline)
+	}
+	unixConnection, ok := connection.(*net.UnixConn)
+	if !ok {
+		return state{}, fmt.Errorf("%w: требуется Unix socket", ErrUnavailable)
+	}
+	raw, err := unixConnection.SyscallConn()
+	if err != nil {
+		return state{}, fmt.Errorf("%w: %w", ErrUnavailable, err)
+	}
+	var credentials *unix.Ucred
+	var credentialErr error
+	if err = raw.Control(func(fd uintptr) {
+		credentials, credentialErr = unix.GetsockoptUcred(int(fd), unix.SOL_SOCKET, unix.SO_PEERCRED)
+	}); err != nil {
+		return state{}, fmt.Errorf("%w: %w", ErrUnavailable, err)
+	}
+	if credentialErr != nil || credentials == nil || credentials.Uid != 0 {
+		return state{}, fmt.Errorf("%w: неверный владелец socket", ErrUnavailable)
+	}
+	if err = json.NewEncoder(connection).Encode(request); err != nil {
+		return state{}, fmt.Errorf("%w: %w", ErrUnavailable, err)
+	}
+	line, err := bufio.NewReader(io.LimitReader(connection, 16385)).ReadBytes('\n')
+	if err != nil || len(line) > 16384 {
+		return state{}, fmt.Errorf("%w: некорректный ответ", ErrUnavailable)
+	}
+	var response reply
+	decoder := json.NewDecoder(bytes.NewReader(line))
+	decoder.DisallowUnknownFields()
+	if err = decoder.Decode(&response); err != nil {
+		return state{}, fmt.Errorf("%w: %w", ErrUnavailable, err)
+	}
+	if response.Error != "" {
+		return state{}, fmt.Errorf("%s", response.Error)
+	}
+	return response.State, nil
+}
