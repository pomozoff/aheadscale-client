+
+#define AHEADSCALE_AUTH_REUSE "reuse"
+#define AHEADSCALE_AUTH_LOGIN "login"
+#define AHEADSCALE_AUTH_SETUP_KEY "setup-key"
+#define AHEADSCALE_AUTH_SSO "sso"
+
+#define AHEADSCALE_KEY_AUTH "auth"
+#define AHEADSCALE_KEY_SETUP_KEY "setup-key"
+#define AHEADSCALE_KEY_MANAGEMENT_URL "management-url"
+#define AHEADSCALE_KEY_ADMIN_URL "admin-url"
+#define AHEADSCALE_KEY_USERNAME "username"
+#define AHEADSCALE_KEY_INTERFACE_NAME "interface-name"
+#define AHEADSCALE_KEY_HOSTNAME "hostname"
+#define AHEADSCALE_KEY_PRE_SHARED_KEY "pre-shared-key"
+
+G_BEGIN_DECLS
+
+typedef enum {
+    AHEADSCALE_EDITOR_ERROR_INVALID_AUTH,
+    AHEADSCALE_EDITOR_ERROR_INVALID_URL,
+    AHEADSCALE_EDITOR_ERROR_INVALID_INTERFACE,
+} AheadscaleEditorError;
+
+#define AHEADSCALE_EDITOR_ERROR aheadscale_editor_error_quark()
+GQuark aheadscale_editor_error_quark(void);
+
+typedef struct {
+    char *auth_mode;
+    char *management_url;
+    char *admin_url;
+    char *username;
+    char *interface_name;
+    char *hostname;
+    char *setup_key;
+    char *pre_shared_key;
+} AheadscaleEditorValues;
+
+void aheadscale_editor_values_init(AheadscaleEditorValues *values);
+void aheadscale_editor_values_clear(AheadscaleEditorValues *values);
+void aheadscale_editor_values_load(AheadscaleEditorValues *values, NMConnection *connection);
+gboolean aheadscale_editor_values_validate(const AheadscaleEditorValues *values, GError **error);
+gboolean aheadscale_editor_values_save(const AheadscaleEditorValues *values, NMConnection *connection, GError **error);
+
+G_END_DECLS
+
+#endif
diff --git a/properties/nm-aheadscale-editor-plugin-test.c b/properties/nm-aheadscale-editor-plugin-test.c
new file mode 100644
index 0000000..58176a5
--- /dev/null
+++ b/properties/nm-aheadscale-editor-plugin-test.c
@@ -0,0 +1,64 @@
+#include "nm-aheadscale-editor-model.h"
+
+#include <NetworkManager.h>
+
+static void
+test_plugin_loads_from_file(void)
+{
+    const char *path;
+    GError *error = NULL;
+    NMVpnEditorPlugin *plugin;
+    char *name = NULL;
+    char *service = NULL;
+
+    path = g_getenv("AHEADSCALE_EDITOR_PLUGIN_PATH");
+    g_assert_nonnull(path);
+    g_assert_true(g_path_is_absolute(path));
+
+    plugin = nm_vpn_editor_plugin_load_from_file(path, AHEADSCALE_SERVICE_NAME, -1, NULL, NULL, &error);
+    g_assert_no_error(error);
+    g_assert_nonnull(plugin);
+
+    g_object_get(plugin,
+                 NM_VPN_EDITOR_PLUGIN_NAME,
+                 &name,
+                 NM_VPN_EDITOR_PLUGIN_SERVICE,
+                 &service,
+                 NULL);
+
+    g_assert_cmpstr(name, ==, "Aheadscale");
+    g_assert_cmpstr(service, ==, AHEADSCALE_SERVICE_NAME);
+
+    g_free(name);
+    g_free(service);
+    g_object_unref(plugin);
+}
+
+static void
+test_plugin_coexists_with_upstream(void)
+{
+    GError *error = NULL;
+    const char *upstream = g_getenv("AHEADSCALE_UPSTREAM_PLUGIN_PATH");
+    const char *path = g_getenv("AHEADSCALE_EDITOR_PLUGIN_PATH");
+    NMVpnEditorPlugin *original, *aheadscale;
+    g_assert_nonnull(upstream);
+    g_assert_true(g_path_is_absolute(upstream));
+    original = nm_vpn_editor_plugin_load_from_file(upstream, "org.freedesktop.NetworkManager.netbird", -1, NULL, NULL, &error);
+    g_assert_no_error(error);
+    g_assert_nonnull(original);
+    aheadscale = nm_vpn_editor_plugin_load_from_file(path, AHEADSCALE_SERVICE_NAME, -1, NULL, NULL, &error);
+    g_assert_no_error(error);
+    g_assert_nonnull(aheadscale);
+    g_assert_cmpuint(G_OBJECT_TYPE(original), !=, G_OBJECT_TYPE(aheadscale));
+    g_object_unref(aheadscale);
+    g_object_unref(original);
+}
+
+int
+main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_func("/aheadscale-editor/plugin-load", test_plugin_loads_from_file);
+    g_test_add_func("/aheadscale-editor/coexists-with-upstream", test_plugin_coexists_with_upstream);
+    return g_test_run();
+}
