+++ b/properties/nm-aheadscale-editor-model.h
@@ -0,0 +1,53 @@
+#ifndef NM_AHEADSCALE_EDITOR_MODEL_H
+#define NM_AHEADSCALE_EDITOR_MODEL_H
+
+#include <NetworkManager.h>
+#include <glib.h>
+
+#define AHEADSCALE_SERVICE_NAME "org.freedesktop.NetworkManager.aheadscale"
+
+#define AHEADSCALE_AUTH_REUSE "reuse"
+#define AHEADSCALE_AUTH_LOGIN "login"
+#define AHEADSCALE_AUTH_SETUP_KEY "setup-key"
+#define AHEADSCALE_AUTH_SSO "sso"
+
+#define AHEADSCALE_KEY_AUTH "auth"
+#define AHEADSCALE_KEY_SETUP_KEY "setup-key"
+#define AHEADSCALE_KEY_MANAGEMENT_URL "management-url"
+#define AHEADSCALE_KEY_ADMIN_URL "admin-url"
+#define AHEADSCALE_KEY_USERNAME "username"
+#define AHEADSCALE_KEY_INTERFACE_NAME "interface-name"
+#define AHEADSCALE_KEY_HOSTNAME "hostname"
+#define AHEADSCALE_KEY_PRE_SHARED_KEY "pre-shared-key"
+
+G_BEGIN_DECLS
+
+typedef enum {
+    AHEADSCALE_EDITOR_ERROR_INVALID_AUTH,
+    AHEADSCALE_EDITOR_ERROR_INVALID_URL,
+    AHEADSCALE_EDITOR_ERROR_INVALID_INTERFACE,
+} AheadscaleEditorError;
+
+#define AHEADSCALE_EDITOR_ERROR aheadscale_editor_error_quark()
+GQuark aheadscale_editor_error_quark(void);
+
+typedef struct {
+    char *auth_mode;
+    char *management_url;
+    char *admin_url;
+    char *username;
+    char *interface_name;
+    char *hostname;
+    char *setup_key;
+    char *pre_shared_key;
+} AheadscaleEditorValues;
+
+void aheadscale_editor_values_init(AheadscaleEditorValues *values);
+void aheadscale_editor_values_clear(AheadscaleEditorValues *values);
+void aheadscale_editor_values_load(AheadscaleEditorValues *values, NMConnection *connection);
+gboolean aheadscale_editor_values_validate(const AheadscaleEditorValues *values, GError **error);
+gboolean aheadscale_editor_values_save(const AheadscaleEditorValues *values, NMConnection *connection, GError **error);
+
+G_END_DECLS
+
+#endif
diff --git a/properties/nm-aheadscale-editor-plugin-test.c b/properties/nm-aheadscale-editor-plugin-test.c
new file mode 100644
index 0000000..58176a5
--- /dev/null
+++ b/properties/nm-aheadscale-editor-plugin-test.c
@@ -0,0 +1,64 @@
+#include "nm-aheadscale-editor-model.h"
+
+#include <NetworkManager.h>
+
+static void
+test_plugin_loads_from_file(void)
+{
+    const char *path;
+    GError *error = NULL;
+    NMVpnEditorPlugin *plugin;
+    char *name = NULL;
+    char *service = NULL;
+
+    path = g_getenv("AHEADSCALE_EDITOR_PLUGIN_PATH");
+    g_assert_nonnull(path);
+    g_assert_true(g_path_is_absolute(path));
+
+    plugin = nm_vpn_editor_plugin_load_from_file(path, AHEADSCALE_SERVICE_NAME, -1, NULL, NULL, &error);
+    g_assert_no_error(error);
+    g_assert_nonnull(plugin);
+
+    g_object_get(plugin,
+                 NM_VPN_EDITOR_PLUGIN_NAME,
+                 &name,
+                 NM_VPN_EDITOR_PLUGIN_SERVICE,
+                 &service,
+                 NULL);
+
+    g_assert_cmpstr(name, ==, "Aheadscale");
+    g_assert_cmpstr(service, ==, AHEADSCALE_SERVICE_NAME);
+
+    g_free(name);
+    g_free(service);
+    g_object_unref(plugin);
+}
+
+static void
+test_plugin_coexists_with_upstream(void)
+{
+    GError *error = NULL;
+    const char *upstream = g_getenv("AHEADSCALE_UPSTREAM_PLUGIN_PATH");
+    const char *path = g_getenv("AHEADSCALE_EDITOR_PLUGIN_PATH");
+    NMVpnEditorPlugin *original, *aheadscale;
+    g_assert_nonnull(upstream);
+    g_assert_true(g_path_is_absolute(upstream));
+    original = nm_vpn_editor_plugin_load_from_file(upstream, "org.freedesktop.NetworkManager.netbird", -1, NULL, NULL, &error);
+    g_assert_no_error(error);
+    g_assert_nonnull(original);
+    aheadscale = nm_vpn_editor_plugin_load_from_file(path, AHEADSCALE_SERVICE_NAME, -1, NULL, NULL, &error);
+    g_assert_no_error(error);
+    g_assert_nonnull(aheadscale);
+    g_assert_cmpuint(G_OBJECT_TYPE(original), !=, G_OBJECT_TYPE(aheadscale));
+    g_object_unref(aheadscale);
+    g_object_unref(original);
+}
+
+int
+main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_func("/aheadscale-editor/plugin-load", test_plugin_loads_from_file);
+    g_test_add_func("/aheadscale-editor/coexists-with-upstream", test_plugin_coexists_with_upstream);
+    return g_test_run();
+}
diff --git a/properties/nm-aheadscale-editor-plugin.c b/properties/nm-aheadscale-editor-plugin.c
new file mode 100644
index 0000000..86f492d
--- /dev/null
+++ b/properties/nm-aheadscale-editor-plugin.c
@@ -0,0 +1,228 @@
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE
+#endif
+
+#include "nm-aheadscale-editor-model.h"
+
+#include <NetworkManager.h>
+#include <dlfcn.h>
+
+typedef struct _AheadscaleEditorPlugin {
+    GObject parent;
+} AheadscaleEditorPlugin;
+
+typedef struct _AheadscaleEditorPluginClass {
+    GObjectClass parent;
+} AheadscaleEditorPluginClass;
+
+typedef NMVpnEditor *(*AheadscaleEditorFactory)(NMVpnEditorPlugin *editor_plugin,
+                                             NMConnection *connection,
+                                             GError **error);
+
+static void aheadscale_editor_plugin_iface_init(NMVpnEditorPluginInterface *iface);
+
+#define AHEADSCALE_TYPE_EDITOR_PLUGIN (aheadscale_editor_plugin_get_type())
+GType aheadscale_editor_plugin_get_type(void);
+NMVpnEditorPlugin *nm_vpn_editor_plugin_factory(GError **error);
+
+G_DEFINE_TYPE_EXTENDED(AheadscaleEditorPlugin,
+                       aheadscale_editor_plugin,
+                       G_TYPE_OBJECT,
+                       0,
+                       G_IMPLEMENT_INTERFACE(NM_TYPE_VPN_EDITOR_PLUGIN, aheadscale_editor_plugin_iface_init))
+
+enum {
+    PROP_0,
+    PROP_NAME,
+    PROP_DESCRIPTION,
+    PROP_SERVICE,
+};
+
+static const char *
+editor_module_name(void)
+{
+    dlerror();
+    if (dlsym(RTLD_DEFAULT, "gtk_container_add"))
+        return "libnm-vpn-plugin-aheadscale-editor.so";
+    dlerror();
+
+    return "libnm-gtk4-vpn-plugin-aheadscale-editor.so";
+}
+
+static gpointer
+load_editor_factory(const char *module_name, GError **error)
+{
+    static struct {
+        gpointer factory;
+        void *module;
+        char *module_name;
+    } cached = { 0 };
+    Dl_info plugin_info;
+    char *module_dir = NULL;
+    char *module_path = NULL;
+    const char *load_error;
+    gpointer factory;
+    void *module;
+
+    if (cached.factory) {
+        if (g_strcmp0(cached.module_name, module_name) != 0) {
+            g_set_error(error,
+                        NM_VPN_PLUGIN_ERROR,
+                        NM_VPN_PLUGIN_ERROR_FAILED,
+                        "editor module already loaded as %s",
+                        cached.module_name);
+            return NULL;
+        }
+        return cached.factory;
+    }
+
+    if (g_path_is_absolute(module_name)) {
+        module_path = g_strdup(module_name);
+    } else {
+        if (!dladdr(nm_vpn_editor_plugin_factory, &plugin_info)) {
+            load_error = dlerror();
+            g_set_error(error,
+                        NM_VPN_PLUGIN_ERROR,
+                        NM_VPN_PLUGIN_ERROR_FAILED,
+                        "unable to get editor plugin path: %s",
+                        load_error ? load_error : "unknown error");
+            return NULL;
+        }
+
+        module_dir = g_path_get_dirname(plugin_info.dli_fname);
+        module_path = g_build_filename(module_dir, module_name, NULL);
+    }
+
+    module = dlopen(module_path, RTLD_LAZY | RTLD_LOCAL);
+    if (!module) {
+        load_error = dlerror();
+        if (!g_file_test(module_path, G_FILE_TEST_EXISTS)) {
+            g_set_error(error,
+                        G_FILE_ERROR,
+                        G_FILE_ERROR_NOENT,
+                        "missing editor plugin file \"%s\"",
+                        module_path);
+        } else {
+            g_set_error(error,
+                        NM_VPN_PLUGIN_ERROR,
+                        NM_VPN_PLUGIN_ERROR_FAILED,
+                        "cannot load editor plugin: %s",
+                        load_error ? load_error : "unknown error");
+        }
+        g_free(module_dir);
+        g_free(module_path);
+        return NULL;
+    }
+
+    dlerror();
+    factory = dlsym(module, "nm_vpn_editor_factory_aheadscale");
+    load_error = dlerror();
+    if (load_error) {
+        g_set_error(error,
+                    NM_VPN_PLUGIN_ERROR,
+                    NM_VPN_PLUGIN_ERROR_FAILED,
+                    "cannot load editor factory from plugin: %s",
+                    load_error);
+        dlclose(module);
+        g_free(module_dir);
+        g_free(module_path);
+        return NULL;
+    }
+
+    cached.factory = factory;
+    /* Keep the module loaded; editor GTypes cannot be unloaded safely. */
+    cached.module = module;
+    cached.module_name = g_strdup(module_name);
+
+    g_free(module_dir);
+    g_free(module_path);
+    return cached.factory;
+}
+
+static void
+aheadscale_editor_plugin_get_property(GObject *object, guint prop_id, GValue *value, GParamSpec *pspec)
+{
+    (void) object;
+
+    switch (prop_id) {
+    case PROP_NAME:
+        g_value_set_string(value, "Aheadscale");
+        break;
+    case PROP_DESCRIPTION:
+        g_value_set_string(value, "Aheadscale VPN");
+        break;
+    case PROP_SERVICE:
+        g_value_set_string(value, AHEADSCALE_SERVICE_NAME);
+        break;
+    default:
+        G_OBJECT_WARN_INVALID_PROPERTY_ID(object, prop_id, pspec);
+        break;
+    }
+}
+
+static void
+aheadscale_editor_plugin_class_init(AheadscaleEditorPluginClass *klass)
+{
+    GObjectClass *object_class = G_OBJECT_CLASS(klass);
+
+    object_class->get_property = aheadscale_editor_plugin_get_property;
+
+    g_object_class_override_property(object_class, PROP_NAME, NM_VPN_EDITOR_PLUGIN_NAME);
+    g_object_class_override_property(object_class, PROP_DESCRIPTION, NM_VPN_EDITOR_PLUGIN_DESCRIPTION);
+    g_object_class_override_property(object_class, PROP_SERVICE, NM_VPN_EDITOR_PLUGIN_SERVICE);
+}
+
+static void
+aheadscale_editor_plugin_init(AheadscaleEditorPlugin *plugin)
+{
+    (void) plugin;
+}
+
+static NMVpnEditor *
+get_editor(NMVpnEditorPlugin *plugin, NMConnection *connection, GError **error)
+{
+    AheadscaleEditorFactory factory;
+    NMVpnEditor *editor;
+
+    g_return_val_if_fail(NM_IS_VPN_EDITOR_PLUGIN(plugin), NULL);
+    g_return_val_if_fail(NM_IS_CONNECTION(connection), NULL);
+    g_return_val_if_fail(!error || !*error, NULL);
+
+    factory = (AheadscaleEditorFactory) load_editor_factory(editor_module_name(), error);
+    if (!factory)
+        return NULL;
+
+    editor = factory(plugin, connection, error);
+    if (!editor) {
+        if (error && !*error)
+            g_set_error_literal(error,
+                                NM_VPN_PLUGIN_ERROR,
+                                NM_VPN_PLUGIN_ERROR_FAILED,
+                                "unknown error creating editor instance");
+        return NULL;
+    }
+
+    g_return_val_if_fail(NM_IS_VPN_EDITOR(editor), NULL);
+    return editor;
+}
+
+static NMVpnEditorPluginCapability
+get_capabilities(NMVpnEditorPlugin *plugin)
+{
+    (void) plugin;
+    return NM_VPN_EDITOR_PLUGIN_CAPABILITY_NONE;
+}
+
+static void
+aheadscale_editor_plugin_iface_init(NMVpnEditorPluginInterface *iface)
+{
+    iface->get_editor = get_editor;
+    iface->get_capabilities = get_capabilities;
+}
+
+NMVpnEditorPlugin *
+nm_vpn_editor_plugin_factory(GError **error)
+{
+    (void) error;
+    return NM_VPN_EDITOR_PLUGIN(g_object_new(AHEADSCALE_TYPE_EDITOR_PLUGIN, NULL));
+}
diff --git a/properties/nm-aheadscale-editor.c b/properties/nm-aheadscale-editor.c
new file mode 100644
index 0000000..c23a674
--- /dev/null
+++ b/properties/nm-aheadscale-editor.c
@@ -0,0 +1,424 @@
+#include "nm-aheadscale-editor.h"
+
+#include "nm-aheadscale-editor-model.h"
+
+#include <nma-vpn-password-dialog.h>
+
+struct _AheadscaleEditor {
+    GObject parent;
+
+    GtkWidget *widget;
+    GtkWidget *auth_combo;
+    GtkWidget *setup_key_section;
+    GtkWidget *management_url_entry;
+    GtkWidget *admin_url_entry;
+    GtkWidget *username_entry;
+    GtkWidget *setup_key_entry;
+    GtkWidget *interface_name_entry;
+    GtkWidget *hostname_entry;
+    GtkWidget *pre_shared_key_entry;
+    gboolean loading;
+};
+
+static void aheadscale_editor_iface_init(NMVpnEditorInterface *iface);
+
+G_DEFINE_TYPE_EXTENDED(AheadscaleEditor,
+                       aheadscale_editor,
+                       G_TYPE_OBJECT,
+                       0,
+                       G_IMPLEMENT_INTERFACE(NM_TYPE_VPN_EDITOR, aheadscale_editor_iface_init))
+
+static void
+set_widget_margin(GtkWidget *widget, int margin)
+{
+#if GTK_CHECK_VERSION(4, 0, 0)
+    gtk_widget_set_margin_top(widget, margin);
+    gtk_widget_set_margin_bottom(widget, margin);
+    gtk_widget_set_margin_start(widget, margin);
+    gtk_widget_set_margin_end(widget, margin);
+#else
+    gtk_container_set_border_width(GTK_CONTAINER(widget), margin);
+#endif
+}
+
+static void
+frame_set_child(GtkWidget *frame, GtkWidget *child)
+{
+#if GTK_CHECK_VERSION(4, 0, 0)
+    gtk_frame_set_child(GTK_FRAME(frame), child);
+#else
+    gtk_container_add(GTK_CONTAINER(frame), child);
+#endif
+}
+
+static GtkWidget *
+frame_child(GtkWidget *frame)
+{
+#if GTK_CHECK_VERSION(4, 0, 0)
+    return gtk_frame_get_child(GTK_FRAME(frame));
+#else
+    return gtk_bin_get_child(GTK_BIN(frame));
+#endif
+}
+
+static void
+box_append_child(GtkWidget *box, GtkWidget *child)
+{
+#if GTK_CHECK_VERSION(4, 0, 0)
+    gtk_box_append(GTK_BOX(box), child);
+#else
+    gtk_box_pack_start(GTK_BOX(box), child, FALSE, FALSE, 0);
+#endif
+}
+
+static void
+entry_set_text_value(GtkWidget *entry, const char *value)
+{
+#if GTK_CHECK_VERSION(4, 0, 0)
+    gtk_editable_set_text(GTK_EDITABLE(entry), value);
+#else
+    gtk_entry_set_text(GTK_ENTRY(entry), value);
+#endif
+}
+
+static const char *
+entry_text_value(GtkWidget *entry)
+{
+#if GTK_CHECK_VERSION(4, 0, 0)
+    return gtk_editable_get_text(GTK_EDITABLE(entry));
+#else
+    return gtk_entry_get_text(GTK_ENTRY(entry));
+#endif
+}
+
+static GtkWidget *
+new_section(const char *title)
+{
+    GtkWidget *frame;
+    GtkWidget *grid;
+
+    frame = gtk_frame_new(title);
+    gtk_widget_set_hexpand(frame, TRUE);
+
+    grid = gtk_grid_new();
+    gtk_grid_set_row_spacing(GTK_GRID(grid), 8);
+    gtk_grid_set_column_spacing(GTK_GRID(grid), 12);
+    set_widget_margin(grid, 12);
+    frame_set_child(frame, grid);
+
+    return frame;
+}
+
+static GtkWidget *
+section_grid(GtkWidget *section)
+{
+    return frame_child(section);
+}
+
+static GtkWidget *
+new_label(const char *text)
+{
+    GtkWidget *label;
+
+    label = gtk_label_new(text);
+    gtk_widget_set_halign(label, GTK_ALIGN_START);
+    gtk_widget_set_valign(label, GTK_ALIGN_CENTER);
+    return label;
+}
+
+static GtkWidget *
+new_entry(void)
+{
+    GtkWidget *entry;
+
+    entry = gtk_entry_new();
+    gtk_widget_set_hexpand(entry, TRUE);
+    return entry;
+}
+
+static void
+attach_row(GtkWidget *grid, int row, const char *label, GtkWidget *input)
+{
+    gtk_grid_attach(GTK_GRID(grid), new_label(label), 0, row, 1, 1);
+    gtk_grid_attach(GTK_GRID(grid), input, 1, row, 1, 1);
+}
+
+static void
+emit_changed(AheadscaleEditor *self)
+{
+    if (self->loading)
+        return;
+
+    g_signal_emit_by_name(self, "changed");
+}
+
+static void
+update_visible_sections(AheadscaleEditor *self)
+{
+    const char *auth_mode;
+
+    auth_mode = gtk_combo_box_get_active_id(GTK_COMBO_BOX(self->auth_combo));
+    gtk_widget_set_visible(self->setup_key_section, g_strcmp0(auth_mode, AHEADSCALE_AUTH_SETUP_KEY) == 0);
+}
+
+static void
+widget_changed_cb(GtkWidget *widget, gpointer user_data)
+{
+    AheadscaleEditor *self = AHEADSCALE_EDITOR(user_data);
+
+    (void) widget;
+    update_visible_sections(self);
+    emit_changed(self);
+}
+
+static void
+connect_changed(AheadscaleEditor *self, GtkWidget *widget)
+{
+    g_signal_connect(widget, "changed", G_CALLBACK(widget_changed_cb), self);
+}
+
+static void
+set_entry_text(GtkWidget *entry, const char *value)
+{
+    entry_set_text_value(entry, value ? value : "");
+}
+
+static char *
+entry_text(GtkWidget *entry)
+{
+    return g_strdup(entry_text_value(entry));
+}
+
+static char *
+trimmed_entry_text(GtkWidget *entry)
+{
+    char *value;
+
+    value = entry_text(entry);
+    g_strstrip(value);
+    return value;
+}
+
+static void
+fill_values_from_ui(AheadscaleEditor *self, AheadscaleEditorValues *values)
+{
+    const char *auth_mode;
+
+    aheadscale_editor_values_init(values);
+
+    auth_mode = gtk_combo_box_get_active_id(GTK_COMBO_BOX(self->auth_combo));
+    g_free(values->auth_mode);
+    values->auth_mode = g_strdup(auth_mode ? auth_mode : AHEADSCALE_AUTH_SSO);
+
+    values->management_url = trimmed_entry_text(self->management_url_entry);
+    values->admin_url = trimmed_entry_text(self->admin_url_entry);
+    values->username = trimmed_entry_text(self->username_entry);
+    values->interface_name = trimmed_entry_text(self->interface_name_entry);
+    values->hostname = trimmed_entry_text(self->hostname_entry);
+    values->setup_key = entry_text(self->setup_key_entry);
+    values->pre_shared_key = entry_text(self->pre_shared_key_entry);
+}
+
+static void
+load_values_into_ui(AheadscaleEditor *self, const AheadscaleEditorValues *values)
+{
+    self->loading = TRUE;
+
+    if (!gtk_combo_box_set_active_id(GTK_COMBO_BOX(self->auth_combo), values->auth_mode))
+        gtk_combo_box_set_active_id(GTK_COMBO_BOX(self->auth_combo), AHEADSCALE_AUTH_SSO);
+
+    set_entry_text(self->management_url_entry, values->management_url);
+    set_entry_text(self->admin_url_entry, values->admin_url);
+    set_entry_text(self->username_entry, values->username);
+    set_entry_text(self->interface_name_entry, values->interface_name);
+    set_entry_text(self->hostname_entry, values->hostname);
+    set_entry_text(self->setup_key_entry, values->setup_key);
+    set_entry_text(self->pre_shared_key_entry, values->pre_shared_key);
+
+    update_visible_sections(self);
+    self->loading = FALSE;
+}
+
+static void
+hide_managed_settings(GtkWidget *widget)
+{
+#if GTK_MAJOR_VERSION < 4
+    gtk_widget_set_no_show_all(widget, TRUE);
+#endif
+    gtk_widget_set_visible(widget, FALSE);
+}
+
+static void
+build_main_section(AheadscaleEditor *self)
+{
+    GtkWidget *section;
+    GtkWidget *grid;
+
+    section = new_section("Aheadscale");
+    grid = section_grid(section);
+
+    self->auth_combo = gtk_combo_box_text_new();
+    gtk_combo_box_text_append(GTK_COMBO_BOX_TEXT(self->auth_combo), AHEADSCALE_AUTH_SSO, "SSO");
+    gtk_combo_box_text_append(GTK_COMBO_BOX_TEXT(self->auth_combo), AHEADSCALE_AUTH_SETUP_KEY, "Setup key");
+    gtk_widget_set_hexpand(self->auth_combo, TRUE);
+
+    self->management_url_entry = new_entry();
+    gtk_entry_set_placeholder_text(GTK_ENTRY(self->management_url_entry), "https://aheadscale.ru");
+    self->admin_url_entry = new_entry();
+    gtk_entry_set_placeholder_text(GTK_ENTRY(self->admin_url_entry), "https://aheadscale.ru");
+    self->username_entry = new_entry();
+
+    /* One installed service profile owns registration and addresses. Hidden
+     * fields retain loaded values but cannot invite manual server entry. */
+    gtk_widget_set_sensitive(self->auth_combo, FALSE);
+    gtk_widget_set_sensitive(self->management_url_entry, FALSE);
+    gtk_widget_set_sensitive(self->admin_url_entry, FALSE);
+    gtk_widget_set_sensitive(self->username_entry, FALSE);
+    attach_row(grid, 0, "Вход через браузер", self->auth_combo);
+    /* Hidden fields still belong to the editor's widget tree. */
+    GtkWidget *managed = gtk_box_new(GTK_ORIENTATION_VERTICAL, 0);
+    box_append_child(managed, self->management_url_entry);
+    box_append_child(managed, self->admin_url_entry);
+    box_append_child(managed, self->username_entry);
+    box_append_child(section, managed);
+    hide_managed_settings(managed);
+
+    box_append_child(self->widget, section);
+}
+
+static void
+build_setup_key_section(AheadscaleEditor *self)
+{
+    GtkWidget *grid;
+
+    self->setup_key_section = new_section("Setup key");
+    grid = section_grid(self->setup_key_section);
+
+    self->setup_key_entry = new_entry();
+    gtk_entry_set_visibility(GTK_ENTRY(self->setup_key_entry), FALSE);
+    gtk_entry_set_input_purpose(GTK_ENTRY(self->setup_key_entry), GTK_INPUT_PURPOSE_PASSWORD);
+    attach_row(grid, 0, "Setup key", self->setup_key_entry);
+
+    box_append_child(self->widget, self->setup_key_section);
+}
+
+static void
+build_advanced_section(AheadscaleEditor *self)
+{
+    GtkWidget *section;
+    GtkWidget *grid;
+
+    section = new_section("Advanced");
+    grid = section_grid(section);
+
+    self->interface_name_entry = new_entry();
+    gtk_entry_set_placeholder_text(GTK_ENTRY(self->interface_name_entry), "wt0");
+    self->hostname_entry = new_entry();
+    self->pre_shared_key_entry = new_entry();
+    gtk_entry_set_visibility(GTK_ENTRY(self->pre_shared_key_entry), FALSE);
+    gtk_entry_set_input_purpose(GTK_ENTRY(self->pre_shared_key_entry), GTK_INPUT_PURPOSE_PASSWORD);
+
+    attach_row(grid, 0, "Interface name", self->interface_name_entry);
+    attach_row(grid, 1, "Hostname", self->hostname_entry);
+    attach_row(grid, 2, "Pre-shared key", self->pre_shared_key_entry);
+    /* Advanced service settings are managed by the installed package. */
+    gtk_widget_set_sensitive(section, FALSE);
+    box_append_child(self->widget, section);
+    hide_managed_settings(section);
+}
+
+static void
+connect_ui_signals(AheadscaleEditor *self)
+{
+    connect_changed(self, self->auth_combo);
+    connect_changed(self, self->management_url_entry);
+    connect_changed(self, self->admin_url_entry);
+    connect_changed(self, self->username_entry);
+    connect_changed(self, self->setup_key_entry);
+    connect_changed(self, self->interface_name_entry);
+    connect_changed(self, self->hostname_entry);
+    connect_changed(self, self->pre_shared_key_entry);
+}
+
+static void
+aheadscale_editor_init(AheadscaleEditor *self)
+{
+    self->widget = gtk_box_new(GTK_ORIENTATION_VERTICAL, 12);
+    set_widget_margin(self->widget, 12);
+    g_object_ref_sink(self->widget);
+
+    build_main_section(self);
+    build_setup_key_section(self);
+    build_advanced_section(self);
+    connect_ui_signals(self);
+}
+
+static void
+aheadscale_editor_dispose(GObject *object)
+{
+    AheadscaleEditor *self = AHEADSCALE_EDITOR(object);
+
+    g_clear_object(&self->widget);
+    G_OBJECT_CLASS(aheadscale_editor_parent_class)->dispose(object);
+}
+
+static void
+aheadscale_editor_class_init(AheadscaleEditorClass *klass)
+{
+    GObjectClass *object_class = G_OBJECT_CLASS(klass);
+
+    object_class->dispose = aheadscale_editor_dispose;
+}
+
+static GObject *
+get_widget(NMVpnEditor *editor)
+{
+    return G_OBJECT(AHEADSCALE_EDITOR(editor)->widget);
+}
+
+static gboolean
+update_connection(NMVpnEditor *editor, NMConnection *connection, GError **error)
+{
+    AheadscaleEditor *self = AHEADSCALE_EDITOR(editor);
+    AheadscaleEditorValues values;
+    gboolean ok;
+
+    fill_values_from_ui(self, &values);
+    ok = aheadscale_editor_values_save(&values, connection, error);
+    aheadscale_editor_values_clear(&values);
+    return ok;
+}
+
+static void
+aheadscale_editor_iface_init(NMVpnEditorInterface *iface)
+{
+    iface->get_widget = get_widget;
+    iface->update_connection = update_connection;
+}
+
+NMVpnEditor *
+aheadscale_editor_new(NMConnection *connection, GError **error)
+{
+    AheadscaleEditor *editor;
+    AheadscaleEditorValues values;
+
+    (void) error;
+
+    editor = g_object_new(AHEADSCALE_TYPE_EDITOR, NULL);
+
+    aheadscale_editor_values_init(&values);
+    aheadscale_editor_values_load(&values, connection);
+    load_values_into_ui(editor, &values);
+    aheadscale_editor_values_clear(&values);
+
+    return NM_VPN_EDITOR(editor);
+}
+
+NMVpnEditor *
+nm_vpn_editor_factory_aheadscale(NMVpnEditorPlugin *editor_plugin, NMConnection *connection, GError **error)
+{
+    (void) editor_plugin;
+
+    g_type_ensure(NMA_VPN_TYPE_PASSWORD_DIALOG);
+    return aheadscale_editor_new(connection, error);
+}
