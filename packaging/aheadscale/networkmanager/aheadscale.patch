+
+/usr/libexec/nm-aheadscale-service	--	gen_context(system_u:object_r:nm_aheadscale_exec_t,s0)
+/usr/libexec/nm-aheadscale-auth-dialog -- gen_context(system_u:object_r:nm_aheadscale_exec_t,s0)
+/run/aheadscale\.sock	-s	gen_context(system_u:object_r:nm_aheadscale_runtime_t,s0)
+/var/run/aheadscale\.sock	-s	gen_context(system_u:object_r:nm_aheadscale_runtime_t,s0)
+
+/run/aheadscale(/.*)? gen_context(system_u:object_r:nm_aheadscale_runtime_t,s0)
