@@ -0,0 +1,115 @@
+// Command nm-aheadscale-service exposes the NetBird NetworkManager VPN plugin service over D-Bus.
+package main
+
+import (
+	"context"
+	"flag"
+	"fmt"
+	"github.com/netbirdio/network-manager-plugin/internal/aheadscale"
+	"log"
+	"os"
+	"os/signal"
+	"strings"
+	"syscall"
+	"time"
+
+	"github.com/godbus/dbus/v5"
+	"github.com/netbirdio/network-manager-plugin/internal/envconfig"
+	"github.com/netbirdio/network-manager-plugin/internal/initsystem"
+	"github.com/netbirdio/network-manager-plugin/internal/netbird/daemonclient"
+	"github.com/netbirdio/network-manager-plugin/internal/nmplugin"
+)
+
+func main() {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	defaultDaemonOptions := daemonclient.DefaultOptionsFromEnv()
+
+	busType := flag.String("bus", "system", "D-Bus bus to use: system or session")
+	debug := flag.Bool("debug", false, "enable verbose logging")
+	daemonAddress := flag.String("daemon-address", defaultDaemonOptions.Address, "Aheadscale daemon gRPC address")
+	startDaemon := flag.Bool("start-daemon", defaultDaemonOptions.StartDaemon, "ask the configured init system to start the Aheadscale daemon if the first dial fails")
+	daemonInitSystem := flag.String("daemon-init-system", envconfig.StringDefault(initsystem.EnvSystem, initsystem.DefaultSystem), "init system used with --start-daemon: auto or systemd")
+	daemonService := flag.String("daemon-service", defaultDaemonOptions.DaemonService, "daemon service name to start when --start-daemon is enabled")
+	dialTimeout := flag.Duration("daemon-dial-timeout", defaultDaemonOptions.DialTimeout, "timeout for dialing the Aheadscale daemon")
+	rpcTimeout := flag.Duration("daemon-rpc-timeout", defaultDaemonOptions.RPCTimeout, "per-RPC timeout for Aheadscale daemon calls without an existing deadline")
+	activationTimeout := flag.Duration("activation-timeout", 90*time.Second, "maximum time to wait for Aheadscale activation phases other than interactive SSO")
+	ssoWaitTimeout := flag.Duration("sso-wait-timeout", 10*time.Minute, "maximum time to wait for interactive Aheadscale SSO completion")
+	flag.Parse()
+
+	logger := log.New(os.Stdout, "nm-aheadscale-service: ", log.LstdFlags|log.Lmicroseconds)
+
+	conn, err := connectBus(*busType)
+	if err != nil {
+		logger.Fatalf("connect %s bus: %v", *busType, err)
+	}
+	defer func() { _ = conn.Close() }()
+	ownerLost, err := aheadscale.WatchNetworkManagerOwner(ctx, conn)
+	if err != nil {
+		logger.Fatal(err)
+	}
+
+	daemonOptions := daemonclient.Options{
+		Address:       *daemonAddress,
+		DialTimeout:   *dialTimeout,
+		RPCTimeout:    *rpcTimeout,
+		StartDaemon:   *startDaemon,
+		DaemonService: *daemonService,
+		Logger:        logger,
+	}
+	if *startDaemon {
+		starter, err := initsystem.NewStarter(*daemonInitSystem)
+		if err != nil {
+			logger.Fatalf("configure daemon autostart: %v", err)
+		}
+		daemonOptions.Starter = starter
+	}
+
+	service := nmplugin.NewService(conn, logger, *debug, nmplugin.ServiceOptions{
+		ActivationController: aheadscale.NewBroker(aheadscale.BrokerPath),
+		ClientFactory:        daemonclient.NewFactory(daemonOptions),
+		ActivationTimeout:    *activationTimeout,
+		SSOWaitTimeout:       *ssoWaitTimeout,
+	})
+	if err := service.Export(); err != nil {
+		logger.Fatalf("export service: %v", err)
+	}
+
+	reply, err := conn.RequestName(nmplugin.BusName, dbus.NameFlagDoNotQueue)
+	if err != nil {
+		logger.Fatalf("request bus name %s: %v", nmplugin.BusName, err)
+	}
+	if reply != dbus.RequestNameReplyPrimaryOwner {
+		logger.Fatalf("bus name %s is already owned (reply=%d)", nmplugin.BusName, reply)
+	}
+	defer func() {
+		_, _ = conn.ReleaseName(nmplugin.BusName)
+	}()
+
+	logger.Printf("serving %s on %s bus at %s", nmplugin.BusName, normalizedBusName(*busType), nmplugin.ObjectPath)
+
+	signals := make(chan os.Signal, 1)
+	signal.Notify(signals, os.Interrupt, syscall.SIGTERM)
+	select {
+	case <-signals:
+	case <-ownerLost:
+	}
+	_ = service.Disconnect()
+
+	logger.Printf("shutting down")
+}
+
+func connectBus(busType string) (*dbus.Conn, error) {
+	switch normalizedBusName(busType) {
+	case "session":
+		return dbus.SessionBus()
+	case "system":
+		return dbus.SystemBus()
+	default:
+		return nil, fmt.Errorf("unsupported bus %q; expected session or system", busType)
+	}
+}
+
+func normalizedBusName(busType string) string {
+	return strings.ToLower(strings.TrimSpace(busType))
+}
diff --git a/internal/aheadscale/broker.go b/internal/aheadscale/broker.go
new file mode 100644
index 0000000..f54cd17
--- /dev/null
+++ b/internal/aheadscale/broker.go
@@ -0,0 +1,110 @@
+//go:build linux
+
+package aheadscale
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net"
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+const BrokerPath = "/run/aheadscale/networkmanager-control.sock"
+
+type Broker struct{ path string }
+
+type Lease struct {
+	Generation     uint64
+	NonInteractive bool
+}
+type message struct {
+	Version    int
+	Operation  string
+	Generation uint64
+	Phase      string
+}
+type state struct {
+	NonInteractive *bool
+	Generation     uint64
+	Phase          string
+	Error          string
+}
+type reply struct {
+	State state
+	Error string
+}
+
+func NewBroker(path string) *Broker { return &Broker{path: path} }
+func (b *Broker) Begin(ctx context.Context) (Lease, error) {
+	response, err := b.exchange(ctx, message{Version: 2, Operation: "Begin"})
+	if err != nil {
+		return Lease{}, err
+	}
+	if response.Generation == 0 || response.NonInteractive == nil {
+		return Lease{}, fmt.Errorf("%w: отсутствует политика взаимодействия", ErrUnavailable)
+	}
+	return Lease{Generation: response.Generation, NonInteractive: *response.NonInteractive}, nil
+}
+func (b *Broker) Complete(ctx context.Context, generation uint64, phase string) error {
+	_, err := b.exchange(ctx, message{Version: 2, Operation: "Complete", Generation: generation, Phase: phase})
+	return err
+}
+func (b *Broker) Cancel(ctx context.Context, generation uint64) error {
+	_, err := b.exchange(ctx, message{Version: 2, Operation: "Cancel", Generation: generation})
+	return err
+}
+func (b *Broker) exchange(ctx context.Context, request message) (state, error) {
+	ctx, cancel := context.WithTimeout(ctx, 5*time.Second)
+	defer cancel()
+	connection, err := (&net.Dialer{}).DialContext(ctx, "unix", b.path)
+	if err != nil {
+		return state{}, fmt.Errorf("%w: %w", ErrUnavailable, err)
+	}
+	defer connection.Close()
+	stop := context.AfterFunc(ctx, func() { _ = connection.Close() })
+	defer stop()
+	if deadline, ok := ctx.Deadline(); ok {
+		_ = connection.SetDeadline(deadline)
+	}
+	unixConnection, ok := connection.(*net.UnixConn)
+	if !ok {
+		return state{}, fmt.Errorf("%w: требуется Unix socket", ErrUnavailable)
+	}
+	raw, err := unixConnection.SyscallConn()
+	if err != nil {
+		return state{}, fmt.Errorf("%w: %w", ErrUnavailable, err)
+	}
+	var credentials *unix.Ucred
+	var credentialErr error
+	if err = raw.Control(func(fd uintptr) {
+		credentials, credentialErr = unix.GetsockoptUcred(int(fd), unix.SOL_SOCKET, unix.SO_PEERCRED)
+	}); err != nil {
+		return state{}, fmt.Errorf("%w: %w", ErrUnavailable, err)
+	}
+	if credentialErr != nil || credentials == nil || credentials.Uid != 0 {
+		return state{}, fmt.Errorf("%w: неверный владелец socket", ErrUnavailable)
+	}
+	if err = json.NewEncoder(connection).Encode(request); err != nil {
+		return state{}, fmt.Errorf("%w: %w", ErrUnavailable, err)
+	}
+	line, err := bufio.NewReader(io.LimitReader(connection, 16385)).ReadBytes('\n')
+	if err != nil || len(line) > 16384 {
+		return state{}, fmt.Errorf("%w: некорректный ответ", ErrUnavailable)
+	}
+	var response reply
+	decoder := json.NewDecoder(bytes.NewReader(line))
+	decoder.DisallowUnknownFields()
+	if err = decoder.Decode(&response); err != nil {
+		return state{}, fmt.Errorf("%w: %w", ErrUnavailable, err)
+	}
+	if response.Error != "" {
+		return state{}, fmt.Errorf("%s", response.Error)
+	}
+	return response.State, nil
+}
diff --git a/internal/aheadscale/broker_test.go b/internal/aheadscale/broker_test.go
