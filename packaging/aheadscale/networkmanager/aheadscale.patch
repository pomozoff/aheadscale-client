+}
+
+func TestDisconnectWaitsForCancelledActivationCleanup(t *testing.T) {
+	obj, fake := newTestingBusObject(t)
+	started := make(chan struct{})
+	release := make(chan struct{})
+	cleanup := make(chan struct{})
+	var once sync.Once
+	finish := func() { once.Do(func() { close(cleanup) }) }
+	defer finish()
+	fake.mu.Lock()
+	fake.loginResponse = daemonclient.LoginResponse{NeedsSSOLogin: true, UserCode: "CODE"}
+	fake.waitSSOStarted = started
+	fake.waitSSORelease = release
+	fake.waitSSOCancelRelease = cleanup
+	fake.mu.Unlock()
+	settings := nmplugin.ConnectionSettings{"vpn": {"data": dbus.MakeVariant(map[string]string{"auth": "sso"})}}
+	require.NoError(t, obj.Call(nmplugin.Interface+".ConnectInteractive", 0, settings, nmplugin.VariantMap{}).Err)
+	select {
+	case <-started:
+	case <-time.After(time.Second):
+		t.Fatal("SSO did not start")
+	}
+	done := make(chan error, 1)
+	go func() { done <- obj.Call(nmplugin.Interface+".Disconnect", 0).Err }()
+	select {
+	case err := <-done:
+		t.Fatalf("Disconnect acknowledged before cleanup: %v", err)
+	case <-time.After(80 * time.Millisecond):
+	}
+	finish()
+	select {
+	case err := <-done:
+		require.NoError(t, err)
+	case <-time.After(time.Second):
+		t.Fatal("Disconnect did not finish")
+	}
+	require.NoError(t, obj.Call(nmplugin.Interface+".ConnectInteractive", 0, settings, nmplugin.VariantMap{}).Err)
+	require.NoError(t, obj.Call(nmplugin.Interface+".Disconnect", 0).Err)
+}
+
+type unavailableCancelController struct{}
+
+// NM may create a replacement active connection before the old Disconnect RPC
+// finishes. The controller has already granted the newer generation by then.
+type supersededDisconnectController struct {
+	mu         sync.Mutex
+	generation uint64
+	cancelling chan struct{}
+	release    chan struct{}
+}
+
+func (c *supersededDisconnectController) Begin(context.Context) (aheadscale.Lease, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.generation++
+	return aheadscale.Lease{Generation: c.generation}, nil
+}
+func (*supersededDisconnectController) Complete(context.Context, uint64, string) error { return nil }
+func (c *supersededDisconnectController) Cancel(ctx context.Context, generation uint64) error {
+	if generation != 1 {
+		return nil
+	}
+	close(c.cancelling)
+	select {
+	case <-c.release:
+		return errors.New("устаревшая отмена подключения")
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+}
+func TestLateDisconnectCannotStopReplacementActivation(t *testing.T) {
+	controller := &supersededDisconnectController{cancelling: make(chan struct{}), release: make(chan struct{})}
+	var once sync.Once
+	release := func() { once.Do(func() { close(controller.release) }) }
+	defer release()
+	obj, _, _ := newTestingBusObjectWithServiceOptions(t, func(options *nmplugin.ServiceOptions) { options.ActivationController = controller })
+	settings := setupKeyConnectionSettings()
+	require.NoError(t, obj.Call(nmplugin.Interface+".Connect", 0, settings).Err)
+	waitForState(t, obj, nmplugin.ServiceStateStarted)
+	done := make(chan error, 1)
+	go func() { done <- obj.Call(nmplugin.Interface+".Disconnect", 0).Err }()
+	select {
+	case <-controller.cancelling:
+	case <-time.After(time.Second):
+		t.Fatal("old disconnect did not reach controller")
+	}
+	require.NoError(t, obj.Call(nmplugin.Interface+".Connect", 0, settings).Err)
+	waitForState(t, obj, nmplugin.ServiceStateStarted)
+	release()
+	select {
+	case err := <-done:
+		require.NoError(t, err)
+	case <-time.After(time.Second):
+		t.Fatal("old disconnect did not finish")
+	}
+	assertState(t, obj, nmplugin.ServiceStateStarted)
+}
+
+func (unavailableCancelController) Begin(context.Context) (aheadscale.Lease, error) {
+	return aheadscale.Lease{Generation: 7}, nil
+}
+func (unavailableCancelController) Complete(context.Context, uint64, string) error { return nil }
+func (unavailableCancelController) Cancel(context.Context, uint64) error {
+	return aheadscale.ErrUnavailable
+}
+func TestDisconnectReportsUnavailableControllerAfterPhysicalCleanup(t *testing.T) {
+	obj, fake, _ := newTestingBusObjectWithServiceOptions(t, func(options *nmplugin.ServiceOptions) { options.ActivationController = unavailableCancelController{} })
+	require.NoError(t, obj.Call(nmplugin.Interface+".Connect", 0, setupKeyConnectionSettings()).Err)
+	waitForState(t, obj, nmplugin.ServiceStateStarted)
+	if err := obj.Call(nmplugin.Interface+".Disconnect", 0).Err; err == nil {
+		t.Fatal("acknowledged an OFF that the controller could not save")
+	}
+	fake.mu.Lock()
+	defer fake.mu.Unlock()
+	require.Equal(t, 1, fake.downCalls)
+	require.True(t, fake.closed)
+}
+
+type automaticActivationController struct{ rejectingActivationController }
+
+func (*automaticActivationController) Begin(context.Context) (aheadscale.Lease, error) {
+	return aheadscale.Lease{Generation: 7, NonInteractive: true}, nil
+}
+
+func TestAutomaticLeaseNeverStartsBrowserEvenWhenNMCallsConnectInteractive(t *testing.T) {
+	controller := &automaticActivationController{}
+	obj, fake, _ := newTestingBusObjectWithServiceOptions(t, func(options *nmplugin.ServiceOptions) { options.ActivationController = controller })
+	fake.mu.Lock()
