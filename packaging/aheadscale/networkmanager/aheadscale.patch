--- /dev/null
+++ b/internal/aheadscale/ownerwatch_test.go
@@ -0,0 +1,57 @@
+//go:build linux
+
+package aheadscale
+
+import (
+	"bufio"
+	"context"
+	"github.com/godbus/dbus/v5"
+	"os/exec"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func TestPluginExitsWhenNMOwnerChanges(t *testing.T) {
+	command := exec.Command("dbus-daemon", "--session", "--nofork", "--print-address=1", "--address=unix:path="+filepath.Join(t.TempDir(), "bus"))
+	stdout, err := command.StdoutPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = command.Start(); err != nil {
+		t.Fatal(err)
+	}
+	defer func() { _ = command.Process.Kill(); _ = command.Wait() }()
+	scanner := bufio.NewScanner(stdout)
+	if !scanner.Scan() {
+		t.Fatal("no private bus")
+	}
+	address := scanner.Text()
+	owner, err := dbus.Connect(address)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer owner.Close()
+	if _, err = owner.RequestName("org.freedesktop.NetworkManager", dbus.NameFlagDoNotQueue); err != nil {
+		t.Fatal(err)
+	}
+	plugin, err := dbus.Connect(address)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer plugin.Close()
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	lost, err := WatchNetworkManagerOwner(ctx, plugin)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = owner.ReleaseName("org.freedesktop.NetworkManager"); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-lost:
+	case <-time.After(time.Second):
+		t.Fatal("plugin retained previous NM session")
+	}
+}
