index 0000000..f183180
--- /dev/null
+++ b/internal/aheadscale/ownerwatch.go
@@ -0,0 +1,50 @@
+//go:build linux
+
+package aheadscale
+
+import (
+	"context"
+	"fmt"
+	"github.com/godbus/dbus/v5"
+	"time"
+)
+
+// WatchNetworkManagerOwner bounds the plugin process to one NM lifetime. A new
+// NM must receive a fresh activation slot, not the old process's active client.
+func WatchNetworkManagerOwner(ctx context.Context, conn *dbus.Conn) (<-chan struct{}, error) {
+	signals := make(chan *dbus.Signal, 16)
+	conn.Signal(signals)
+	match := []dbus.MatchOption{dbus.WithMatchSender("org.freedesktop.DBus"), dbus.WithMatchInterface("org.freedesktop.DBus"), dbus.WithMatchMember("NameOwnerChanged"), dbus.WithMatchArg(0, "org.freedesktop.NetworkManager")}
+	queryCtx, cancel := context.WithTimeout(ctx, 3*time.Second)
+	defer cancel()
+	if err := conn.AddMatchSignalContext(queryCtx, match...); err != nil {
+		conn.RemoveSignal(signals)
+		return nil, err
+	}
+	var owner string
+	if err := conn.BusObject().CallWithContext(queryCtx, "org.freedesktop.DBus.GetNameOwner", 0, "org.freedesktop.NetworkManager").Store(&owner); err != nil {
+		_ = conn.RemoveMatchSignal(match...)
+		conn.RemoveSignal(signals)
+		return nil, fmt.Errorf("NetworkManager недоступен: %w", err)
+	}
+	lost := make(chan struct{})
+	go func() {
+		defer close(lost)
+		defer conn.RemoveSignal(signals)
+		defer conn.RemoveMatchSignal(match...)
+		for {
+			select {
+			case <-ctx.Done():
+				return
+			case signal, ok := <-signals:
+				if !ok {
+					return
+				}
+				if signal != nil && signal.Sender == "org.freedesktop.DBus" && signal.Name == "org.freedesktop.DBus.NameOwnerChanged" && len(signal.Body) == 3 && signal.Body[0] == "org.freedesktop.NetworkManager" && signal.Body[1] == owner {
+					return
+				}
+			}
+		}
+	}()
+	return lost, nil
+}
